# Per-machine settings for the Tools/*.sh scripts.
#   cp Tools/local.env.example Tools/local.env   (git-ignored)
# Plain KEY=value lines, no quotes. Environment variables override this file.
# Never put passwords here; Tools/make-test-env.sh handles test credentials.

# Paired iPad or iPhone (run-on-ipad.sh, ipad-connect.sh, fetch-ipad-log.sh).
# Find it with: xcrun devicectl list devices
SCREENER_DEVICE_UDID=

# iPad simulator for sim-connect.sh. Find it with: xcrun simctl list devices
SCREENER_SIM_UDID=

# Must match SCREENER_BUNDLE_ID in Local.xcconfig if you changed it there.
SCREENER_BUNDLE_ID=com.vestal.screener
